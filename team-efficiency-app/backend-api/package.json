{
  "name": "team-efficiency-backend",
  "version": "1.0.0",
  "description": "Backend API for team code review efficiency app",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist/database/migrate.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "pg": "^8.11.3",
    "socket.io": "^4.7.2",
    "node-cron": "^3.0.2",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/pg": "^8.10.7",
    "@types/node": "^20.8.10",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.2.2",
    "ts-node-dev": "^2.0.0"
  }
}